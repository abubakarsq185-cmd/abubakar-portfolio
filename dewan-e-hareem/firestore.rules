rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Menu overrides (photo / name / price per dish).
    // • Anyone may READ  → so the live menu shows to all visitors.
    // • Only a signed-in owner may WRITE → nobody else can change prices/photos.
    match /menuOverrides/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Everything else is locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
