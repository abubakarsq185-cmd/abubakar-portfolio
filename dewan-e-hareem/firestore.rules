rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The owner's email(s). MUST match window.DEH_OWNERS in firebase-config.js.
    // Replace with the real owner email(s) before going live.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['PASTE_OWNER_EMAIL@example.com'];
    }

    // Menu overrides (photo / name / price per dish).
    // • Anyone may READ  → so the live menu shows to all visitors.
    // • Only the approved OWNER may WRITE → nobody else can change prices/photos.
    match /menuOverrides/{itemId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Everything else is locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
