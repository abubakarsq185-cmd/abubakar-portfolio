# ---------------------------------------------------------------------------
# GymGuide — environment template. Copy to `.env` and fill in real values.
# NEVER commit a populated .env. No secret in this repo is real.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
APP_NAME=GymGuide

# --- Database ---------------------------------------------------------------
# Any PostgreSQL 15+ instance works (local, RDS, Supabase, Neon).
# The migration/owner connection. Runs DDL.
DATABASE_URL=postgres://postgres@localhost:5432/gymguide
# The application connection. MUST be a role WITHOUT BYPASSRLS so that
# row-level security is enforced for every request (see docs/SECURITY.md).
DATABASE_APP_URL=postgres://gymguide_app:change-me@localhost:5432/gymguide
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# --- Auth / sessions --------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
SESSION_SECRET=replace-with-openssl-rand-base64-48
SESSION_TTL_HOURS=720
# Staff accounts may be forced into MFA enrolment.
REQUIRE_STAFF_MFA=false

# --- Object storage (progress photos, exercise media, invoices) -------------
# Adapter: local | s3 | supabase
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
STORAGE_SIGNED_URL_TTL_SECONDS=300
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ---------------------------------------------------------------
# Comma separated list of enabled adapters.
# manual = cash / bank transfer (always available, fully implemented).
# Card / wallet / QR adapters are secure integration stubs: they validate,
# persist and audit everything, but require live credentials to settle money.
PAYMENTS_ENABLED_ADAPTERS=manual
PAYMENTS_DEFAULT_CURRENCY=PKR
# Stripe-style card adapter
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local wallet / QR adapters (JazzCash, Easypaisa, Raast style)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
RAAST_QR_MERCHANT_ID=

# --- Notifications ----------------------------------------------------------
# console = writes to the notification ledger + stdout (default, works offline)
NOTIFY_EMAIL_DRIVER=console
NOTIFY_SMS_DRIVER=console
NOTIFY_PUSH_DRIVER=console
NOTIFY_WHATSAPP_DRIVER=console
NOTIFY_FROM_EMAIL=no-reply@gymguide.app
SMTP_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
EXPO_PUSH_ACCESS_TOKEN=
# WhatsApp Business Cloud API — requires an approved template + opt-in.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- AI ---------------------------------------------------------------------
# Adapter: scripted | anthropic | openai
# `scripted` is deterministic, offline, and safe for demos + CI. It answers only
# from approved content via the same tool-call contract as a live model.
AI_DRIVER=scripted
AI_MODEL=claude-sonnet-4-5
AI_PROMPT_VERSION=coach-2026-08-01
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Hard safety switch: when false, no free-text AI output is ever shown.
AI_COACH_ENABLED=true

# --- Jobs / automations -----------------------------------------------------
JOB_QUEUE_DRIVER=pg
JOB_WORKER_CONCURRENCY=4
AUTOMATION_QUIET_HOURS_START=21:30
AUTOMATION_QUIET_HOURS_END=07:30
DEFAULT_TIMEZONE=Asia/Karachi

# --- Security ---------------------------------------------------------------
RATE_LIMIT_DRIVER=memory
RATE_LIMIT_LOGIN_PER_MINUTE=8
RATE_LIMIT_API_PER_MINUTE=120
WEBHOOK_MAX_SKEW_SECONDS=300

# --- Observability ----------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
ANALYTICS_DRIVER=console
ANALYTICS_WRITE_KEY=

# --- Demo -------------------------------------------------------------------
# Password shared by every seeded demo account. Demo seed only.
SEED_DEMO_PASSWORD=GymGuide!Demo2026
ALLOW_DEMO_LOGIN_HINTS=true
